<Window x:Class="TimeWidget.SettingsWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Settings"
        Width="360"
        Height="420"
        MinWidth="340"
        MinHeight="390"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="置顶"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="锁定位置"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ResizeMenuItem"
                      Header="允许调整大小"
                      IsCheckable="True"
                      Click="ResizeMenuItem_Click" />
            <Separator />
            <MenuItem Header="打开 Windows 设置"
                      Click="OpenSettingsMenuItem_Click" />
            <MenuItem Header="退出"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="AccentBackground" Color="#A72D8CFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="QuickButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="74" />
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="On">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBackground}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="BorderBrush" Value="#CFA7D8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:HighlightedTextBlock Grid.Row="0"
                                           Height="29"
                                           FontFamily="MiSans"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryText}"
                                           HighlightBrush="#FFFF0000"
                                           HighlightStart="0"
                                           HighlightLength="1"
                                           Text="Quick Settings" />

            <UniformGrid Grid.Row="2"
                         Columns="3"
                         Rows="2">
                <Button x:Name="WifiButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="WifiButton_Click" />
                <Button x:Name="BluetoothButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="BluetoothButton_Click" />
                <Button x:Name="AirplaneButton"
                        Margin="0,0,0,8"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="AirplaneButton_Click" />
                <Button x:Name="AccessibilityButton"
                        Margin="0,0,8,0"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="AccessibilityButton_Click" />
                <Button x:Name="BatterySaverButton"
                        Margin="0,0,8,0"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="BatterySaverButton_Click" />
                <Button x:Name="LiveCaptionsButton"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="LiveCaptionsButton_Click" />
            </UniformGrid>

            <StackPanel Grid.Row="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{StaticResource AccentText}"
                               Text="&#xE706;" />
                    <Slider x:Name="BrightnessSlider"
                            Grid.Column="1"
                            Margin="6,0,8,0"
                            Minimum="0"
                            Maximum="100"
                            Value="65"
                            ValueChanged="BrightnessSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="BrightnessSlider_PreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="BrightnessValueText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryText}"
                               Text="--%" />
                </Grid>
                <TextBlock x:Name="BrightnessStatusText"
                           Margin="28,2,0,0"
                           FontFamily="MiSans"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedText}"
                           Text=""
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{StaticResource AccentText}"
                               Text="&#xE995;" />
                    <Slider x:Name="VolumeSlider"
                            Grid.Column="1"
                            Margin="6,0,8,0"
                            Minimum="0"
                            Maximum="100"
                            Value="42"
                            ValueChanged="VolumeSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="VolumeValueText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryText}"
                               Text="--%" />
                </Grid>
                <TextBlock x:Name="VolumeStatusText"
                           Margin="28,2,0,0"
                           FontFamily="MiSans"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedText}"
                           Text=""
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BatteryText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text="Battery  --%" />
                <Button Grid.Column="1"
                        Content="&#xE713;"
                        Style="{StaticResource RoundIconButtonStyle}"
                        Click="SettingsButton_Click" />
                <Button Grid.Column="3"
                        Content="&#xE712;"
                        Style="{StaticResource RoundIconButtonStyle}"
                        Click="MoreButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
