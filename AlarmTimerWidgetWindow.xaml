<Window x:Class="TimeWidget.AlarmTimerWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm Timer"
        Width="360"
        Height="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="置顶"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="锁定位置"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="新增闹钟"
                      Click="AddAlarmMenuItem_Click" />
            <MenuItem Header="停止所有响铃"
                      Click="StopAllRingingMenuItem_Click" />
            <MenuItem Header="重置计时"
                      Click="ResetAllMenuItem_Click" />
            <MenuItem Header="退出"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="WarningText" Color="#FFB86C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="TinyButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="27" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#36506C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="14"
                    Background="{StaticResource SecondaryBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="9,8"
                    MouseLeftButtonDown="AlarmCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="MiSans"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentText}"
                               Text="Alarm" />
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="AlarmMainText"
                                   FontFamily="MiSans"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}"
                                   Text="--:--"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AlarmSubText"
                                   Margin="0,2,0,0"
                                   FontFamily="MiSans"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedText}"
                                   Text="No active"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">
                        <Button Content="+"
                                Style="{StaticResource TinyButtonStyle}"
                                Click="AddAlarmButton_Click" />
                        <Button Content="Stop"
                                Margin="6,0,0,0"
                                Style="{StaticResource TinyButtonStyle}"
                                Click="StopAllRingingButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="14"
                    Background="{StaticResource SecondaryBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="9,8"
                    MouseLeftButtonDown="TimerCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="MiSans"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningText}"
                               Text="Timer" />
                    <TextBlock x:Name="TimerDisplayText"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"
                               Text="25:00" />
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">
                        <Button x:Name="TimerStartPauseButton"
                                Content="Start"
                                Style="{StaticResource TinyButtonStyle}"
                                Click="TimerStartPauseButton_Click" />
                        <Button Content="R"
                                Margin="6,0,0,0"
                                Style="{StaticResource TinyButtonStyle}"
                                Click="TimerResetButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    CornerRadius="14"
                    Background="{StaticResource SecondaryBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="9,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="MiSans"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentText}"
                               Text="Watch" />
                    <TextBlock x:Name="StopwatchDisplayText"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"
                               Text="00:00.00" />
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">
                        <Button x:Name="StopwatchStartPauseButton"
                                Content="Start"
                                Style="{StaticResource TinyButtonStyle}"
                                Click="StopwatchStartPauseButton_Click" />
                        <Button Content="R"
                                Margin="6,0,0,0"
                                Style="{StaticResource TinyButtonStyle}"
                                Click="StopwatchResetButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
