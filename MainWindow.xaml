<Window x:Class="TimeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Widget"
        Width="280"
        Height="150"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="Files"
                      Click="OpenFilesMenuItem_Click" />
            <MenuItem Header="Media"
                      Click="OpenMediaMenuItem_Click" />
            <MenuItem Header="Weather"
                      Click="OpenWeatherMenuItem_Click" />
            <Separator />
            <MenuItem Header="&#x9000;&#x51FA;"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Margin="10"
            CornerRadius="24"
            Background="#FF151922"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TimeText"
                       Grid.Row="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="10,0,0,5"
                       FontFamily="MiSans"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#F6FFFFFF"
                       Text="00:00" />

            <TextBlock x:Name="DateText"
                       Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="10,0,0,0"
                       FontFamily="MiSans"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#E6D8E6F2"
                       Text="0000/00/00 Monday" />
        </Grid>
    </Border>
</Window>
