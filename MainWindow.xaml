<Window x:Class="TimeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Time Widget"
        Width="360"
        Height="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ResizeMenuItem"
                      Header="&#x5141;&#x8BB8;&#x8C03;&#x6574;&#x5927;&#x5C0F;"
                      IsCheckable="True"
                      Click="ResizeMenuItem_Click" />
            <Separator />
            <MenuItem Header="Files"
                      Click="OpenFilesMenuItem_Click" />
            <MenuItem Header="Media"
                      Click="OpenMediaMenuItem_Click" />
            <MenuItem Header="Weather"
                      Click="OpenWeatherMenuItem_Click" />
            <MenuItem Header="Open Alarm Timer Widget"
                      Click="OpenAlarmTimerMenuItem_Click" />
            <MenuItem Header="AI Search"
                      Click="OpenAiSearchMenuItem_Click" />
            <MenuItem Header="Open Calendar Widget"
                      Click="OpenCalendarMenuItem_Click" />
            <MenuItem Header="Open Schedule Widget"
                      Click="OpenScheduleMenuItem_Click" />
            <MenuItem Header="Open VPN Shortcuts"
                      Click="OpenVpnMenuItem_Click" />
            <MenuItem Header="Open Quick Settings"
                      Click="OpenQuickSettingsMenuItem_Click" />
            <MenuItem Header="Open Performance Widget"
                      Click="OpenPerformanceMenuItem_Click" />
            <MenuItem Header="Open Network Traffic"
                      Click="OpenNetworkTrafficMenuItem_Click" />
            <MenuItem Header="Open Audio Control"
                      Click="OpenAudioControlMenuItem_Click" />
            <MenuItem Header="Open Finance Widget"
                      Click="OpenFinanceMenuItem_Click" />
            <Separator />
            <MenuItem Header="&#x9000;&#x51FA;"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Margin="8"
            CornerRadius="24"
            Background="#F21F1E33"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <controls:HighlightedTextBlock x:Name="TimeText"
                                           Grid.Row="0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="24,0,0,5"
                                           Height="58"
                                           FontFamily="MiSans"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Foreground="#F6FFFFFF"
                                           HighlightBrush="#FFFF0000"
                                           HighlightStart="0"
                                           HighlightLength="1"
                                           Text="00:00" />

            <controls:HighlightedTextBlock x:Name="DateText"
                                           Grid.Row="1"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Margin="24,0,0,0"
                                           Height="20"
                                           FontFamily="MiSans"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#E6D8E6F2"
                                           HighlightBrush="#FFFF0000"
                                           Text="0000/00/00 Monday" />
        </Grid>
    </Border>
</Window>
