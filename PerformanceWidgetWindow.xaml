<Window x:Class="TimeWidget.PerformanceWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance"
        Width="360"
        Height="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="置顶"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="锁定位置"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText"
                           FontFamily="MiSans"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"
                           Text="CPU" />
                <TextBlock x:Name="PageText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedText}"
                           Text="1/3" />
            </Grid>

            <Grid x:Name="PageContent"
                  Grid.Row="1"
                  Margin="0,4,0,4"
                  Opacity="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MainValueText"
                               FontFamily="MiSans"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentText}"
                               Text="--%" />
                    <TextBlock x:Name="MainLabelText"
                               Margin="1,-2,0,0"
                               FontFamily="MiSans"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Text="Usage" />
                </StackPanel>

                <Grid Grid.Column="1"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="UsageProgressBar"
                                 Grid.Row="0"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource AccentText}"
                                 Background="{StaticResource SecondaryBackground}" />
                    <UniformGrid Grid.Row="2"
                                 Columns="3">
                        <StackPanel>
                            <TextBlock Text="Freq"
                                       FontFamily="MiSans"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedText}" />
                            <TextBlock x:Name="FrequencyText"
                                       FontFamily="MiSans"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"
                                       Text="--" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Temp"
                                       FontFamily="MiSans"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedText}" />
                            <TextBlock x:Name="TemperatureText"
                                       FontFamily="MiSans"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"
                                       Text="--" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Power"
                                       FontFamily="MiSans"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedText}" />
                            <TextBlock x:Name="PowerText"
                                       FontFamily="MiSans"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"
                                       Text="--" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Grid>

            <TextBlock x:Name="HintText"
                       Grid.Row="2"
                       FontFamily="MiSans"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedText}"
                       Text="Mouse wheel to switch pages"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
