<Window x:Class="TimeWidget.ScheduleWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule"
        Width="420"
        Height="500"
        MinWidth="360"
        MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="置顶"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="锁定位置"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ResizeMenuItem"
                      Header="允许调整大小"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="ResizeMenuItem_Click" />
            <MenuItem x:Name="ThemeMenuItem"
                      Header="浅色模式"
                      IsCheckable="True"
                      Click="ThemeMenuItem_Click" />
            <Separator />
            <MenuItem Header="新增课程"
                      Click="AddCourseMenuItem_Click" />
            <MenuItem Header="回到本周"
                      Click="CurrentWeekMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="ScheduleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="8"
            CornerRadius="22"
            Background="{DynamicResource MainBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="14"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="84" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="WeekTitleText"
                               FontFamily="MiSans"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               Text="Week 1" />
                    <TextBlock x:Name="DateText"
                               Margin="1,3,0,0"
                               FontFamily="MiSans"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}"
                               Text="Today" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="‹"
                            Width="32"
                            Style="{StaticResource ScheduleButtonStyle}"
                            Click="PreviousWeekButton_Click" />
                    <Button Content="Today"
                            Margin="6,0"
                            Style="{StaticResource ScheduleButtonStyle}"
                            Click="CurrentWeekButton_Click" />
                    <Button Content="›"
                            Width="32"
                            Style="{StaticResource ScheduleButtonStyle}"
                            Click="NextWeekButton_Click" />
                    <Button Content="+"
                            Width="32"
                            Margin="6,0,0,0"
                            Style="{StaticResource ScheduleButtonStyle}"
                            Click="AddCourseButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,8"
                    CornerRadius="16"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ScheduleGrid" />
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2"
                    CornerRadius="16"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NextCourseText"
                               Grid.Row="0"
                               FontFamily="MiSans"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentText}"
                               Text="Next: none"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TodayCoursesText"
                               Grid.Row="1"
                               Margin="0,7,0,0"
                               FontFamily="MiSans"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}"
                               Text="No courses today"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
