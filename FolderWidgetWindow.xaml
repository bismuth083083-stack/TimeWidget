<Window x:Class="TimeWidget.FolderWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Files"
        Width="360"
        Height="480"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ResizeMenuItem"
                      Header="&#x5141;&#x8BB8;&#x8C03;&#x6574;&#x5927;&#x5C0F;"
                      IsCheckable="True"
                      Click="ResizeMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF1F1E33" />
        <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F0EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A8D8E6F2" />
        <SolidColorBrush x:Key="ItemBackground" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="ItemHover" Color="#1AFFFFFF" />

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{StaticResource ItemBackground}"
                                CornerRadius="12"
                                Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:HighlightedTextBlock Height="32"
                                                       FontFamily="MiSans"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       HighlightBrush="#FFFF0000"
                                                       HighlightStart="0"
                                                       HighlightLength="1"
                                                       Text="Files" />
                        <TextBlock x:Name="FolderIconText"
                                   Margin="8,3,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{StaticResource PrimaryText}"
                                   Text="&#xE8B7;"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="FolderNameText"
                               Margin="1,1,0,0"
                               FontFamily="MiSans"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryText}"
                               TextTrimming="CharacterEllipsis"
                               Text="No folder selected" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right">
                    <Button Content="Choose"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="ChooseFolderButton_Click" />
                    <Button Content="Refresh"
                            Margin="8,0,0,0"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontFamily="MiSans"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}" />

                <ListBox x:Name="FilesListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Files}"
                         MouseDoubleClick="FilesListBox_MouseDoubleClick"
                         PreviewMouseRightButtonDown="FilesListBox_PreviewMouseRightButtonDown"
                         Padding="0"
                         Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                                      Click="OpenFileMenuItem_Click" />
                            <MenuItem Header="Open File Location"
                                      Click="OpenFileLocationMenuItem_Click" />
                            <MenuItem Header="Copy Path"
                                      Click="CopyPathMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontFamily="MiSans"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryText}"
                                           Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           FontFamily="MiSans"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryText}"
                                           Text="{Binding FileType}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,3,0,0"
                                           FontFamily="MiSans"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryText}"
                                           Text="{Binding ModifiedText}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           FontFamily="MiSans"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryText}"
                                           Text="{Binding SizeText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>
