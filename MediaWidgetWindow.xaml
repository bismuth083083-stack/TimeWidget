<Window x:Class="TimeWidget.MediaWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Media"
        Width="540"
        Height="150"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="Close"
                      Click="CloseMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF151922" />
        <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F0EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A8D8E6F2" />

        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="22"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="192" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Width="70"
                  Height="70">
                <Rectangle x:Name="AlbumArtShape"
                           RadiusX="14"
                           RadiusY="14"
                           Fill="#18FFFFFF" />
                <Grid>
                    <TextBlock x:Name="AlbumArtPlaceholder"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource SecondaryText}"
                               Text="&#xE8D6;" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                <controls:MarqueeTextBlock x:Name="TitleText"
                                           Height="27"
                                           FontFamily="MiSans"
                                           TextSize="21"
                                           TextWeight="Bold"
                                           TextBrush="{StaticResource PrimaryText}"
                                           Text="No media playing" />
                <controls:MarqueeTextBlock x:Name="ArtistText"
                                           Height="18"
                                           Margin="0,5,0,0"
                                           FontFamily="MiSans"
                                           TextSize="13"
                                           TextWeight="Bold"
                                           TextBrush="{StaticResource SecondaryText}"
                                           Text="Unknown artist" />
                <TextBlock x:Name="SourceText"
                           Margin="0,8,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text="No source"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <TextBlock x:Name="PlaybackStatusText"
                           Margin="0,3,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text="Stopped" />
                <TextBlock x:Name="AudioStatusText"
                           Margin="0,3,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text=""
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
            </StackPanel>

            <controls:SpectrumBarsControl x:Name="SpectrumControl"
                                          Grid.Row="0"
                                          Grid.Column="3"
                                          Height="42"
                                          BarBrush="#D8A7D8FF"
                                          VerticalAlignment="Center" />

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="&#xE892;"
                        Style="{StaticResource MediaButtonStyle}"
                        Click="PreviousButton_Click" />
                <Button x:Name="PlayPauseButton"
                        Content="&#xE768;"
                        Margin="12,0"
                        Style="{StaticResource MediaButtonStyle}"
                        Click="PlayPauseButton_Click" />
                <Button Content="&#xE893;"
                        Style="{StaticResource MediaButtonStyle}"
                        Click="NextButton_Click" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
