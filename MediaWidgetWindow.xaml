<Window x:Class="TimeWidget.MediaWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Media"
        Width="360"
        Height="320"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ResizeMenuItem"
                      Header="&#x5141;&#x8BB8;&#x8C03;&#x6574;&#x5927;&#x5C0F;"
                      IsCheckable="True"
                      Click="ResizeMenuItem_Click" />
            <Separator />
            <MenuItem Header="&#x9891;&#x8C31;&#x9AD8;&#x5EA6;&#x500D;&#x7387;"
                      SubmenuClosed="SpectrumHeightMenuItem_SubmenuClosed">
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="210" Margin="4,6">
                            <TextBlock HorizontalAlignment="Right" Margin="0,0,0,5"
                                       Text="{Binding Value, ElementName=SpectrumHeightSlider, StringFormat={}{0:0.0}x}" />
                            <Slider x:Name="SpectrumHeightSlider"
                                    Minimum="0.2" Maximum="5" Value="1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1" LargeChange="0.5"
                                    Height="26" IsMoveToPointEnabled="True"
                                    AutomationProperties.Name="Spectrum height multiplier"
                                    ValueChanged="SpectrumHeightSlider_ValueChanged">
                                <Slider.Template>
                                    <ControlTemplate TargetType="Slider">
                                        <Grid Background="Transparent">
                                            <Border Height="6" CornerRadius="3" Background="#4A5266"
                                                    VerticalAlignment="Center" />
                                            <Track x:Name="PART_Track">
                                                <Track.Resources>
                                                    <Style TargetType="RepeatButton">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="RepeatButton">
                                                                    <Grid Background="Transparent">
                                                                        <Border Height="6" CornerRadius="3"
                                                                                Background="{TemplateBinding Background}"
                                                                                VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Track.Resources>
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#A7D8FF" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Width="14" Height="20">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border CornerRadius="7" Background="#EAF3FF"
                                                                        BorderBrush="#A7D8FF" BorderThickness="1" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Slider.Template>
                            </Slider>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="&#x6062;&#x590D;&#x9ED8;&#x8BA4; (1.0x)"
                          Click="ResetSpectrumHeightMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="Refresh recognition"
                      Click="RefreshRecognitionMenuItem_Click" />
            <MenuItem x:Name="SeekMenuItem"
                      Header="Allow progress seeking (experimental)"
                      IsCheckable="True"
                      Click="SeekMenuItem_Click" />
            <MenuItem Header="Close"
                      Click="CloseMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF1F1E33" />
        <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F0EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A8D8E6F2" />
        <SolidColorBrush x:Key="CardBackground" Color="#33808080" />
        <SolidColorBrush x:Key="AlbumAccent" Color="#FFA7D8FF" />

        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="1"
                                                  Direction="270"
                                                  Opacity="0.18"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AlbumAccent}" />
            <Setter Property="Background" Value="#4032305A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" />
                            <Border x:Name="PART_Track"
                                    Background="Transparent"
                                    CornerRadius="6" />
                            <Grid x:Name="PART_Indicator"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="6" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MediaRootBorder"
            Margin="8"
            CornerRadius="22"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid x:Name="MediaContentGrid"
              SizeChanged="MediaContentGrid_SizeChanged"
              ClipToBounds="True">
            <Rectangle x:Name="AlbumBlurBackground"
                       RadiusX="22"
                       RadiusY="22"
                       Opacity="1"
                       Visibility="Collapsed"
                       IsHitTestVisible="False">
                <Rectangle.Effect>
                    <BlurEffect Radius="35" />
                </Rectangle.Effect>
            </Rectangle>
            <Rectangle x:Name="AlbumDimOverlay"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#99000000"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="122" />
                <RowDefinition Height="64" />
                <RowDefinition Height="20" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Width="118"
                  Height="118">
                <Rectangle x:Name="AlbumArtShape"
                           RadiusX="12"
                           RadiusY="12"
                           Fill="#18FFFFFF" />
                <Grid>
                    <TextBlock x:Name="AlbumArtPlaceholder"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="34"
                               Foreground="{StaticResource SecondaryText}"
                               Text="&#xE8D6;" />
                </Grid>
            </Grid>

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.22"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <controls:MarqueeTextBlock x:Name="TitleText"
                                               Height="33"
                                               FontFamily="MiSans"
                                               TextSize="24"
                                               TextWeight="Bold"
                                               TextBrush="{StaticResource PrimaryText}"
                                               Text="No media playing" />
                    <controls:MarqueeTextBlock x:Name="ArtistText"
                                               Height="24"
                                               Margin="0,6,0,0"
                                               FontFamily="MiSans"
                                               TextSize="17"
                                               TextWeight="Bold"
                                               TextBrush="{StaticResource SecondaryText}"
                                               Text="Unknown artist" />
                <TextBlock x:Name="SourceText"
                           Margin="0,8,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text="No source"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <TextBlock x:Name="PlaybackStatusText"
                           Margin="0,3,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text="Stopped" />
                <TextBlock x:Name="AudioStatusText"
                           Margin="0,3,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryText}"
                           Text=""
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,10,0,0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.22"
                                      Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"
                               Text="00:00" />
                    <controls:SpectrumBarsControl x:Name="SpectrumControl"
                                                  Grid.Column="1"
                                                  Height="38"
                                                  Margin="8,0"
                                                  BarBrush="{StaticResource AlbumAccent}"
                                                  VerticalAlignment="Center" />
                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"
                               Text="--:--" />
                </Grid>
            </Border>

            <ProgressBar x:Name="MediaProgressBar"
                         Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="1"
                         Value="0"
                         PreviewMouseLeftButtonDown="MediaProgressBar_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="MediaProgressBar_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="MediaProgressBar_PreviewMouseLeftButtonUp"
                         LostMouseCapture="MediaProgressBar_LostMouseCapture"
                         Style="{StaticResource MediaProgressStyle}" />

            <StackPanel Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">
                <Button Content="&#xE892;"
                        Style="{StaticResource MediaButtonStyle}"
                        Click="PreviousButton_Click" />
                <Button x:Name="PlayPauseButton"
                        Content="&#xE768;"
                        Margin="12,0"
                        Style="{StaticResource MediaButtonStyle}"
                        Click="PlayPauseButton_Click" />
                <Button Content="&#xE893;"
                        Style="{StaticResource MediaButtonStyle}"
                        Click="NextButton_Click" />
            </StackPanel>

        </Grid>
        </Grid>
    </Border>
</Window>

