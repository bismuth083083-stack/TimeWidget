<Window x:Class="TimeWidget.AiSearchWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="AI Search"
        Width="360"
        Height="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="Add API Key"
                      Click="SetApiKeyMenuItem_Click" />
            <MenuItem Header="&#x6E05;&#x7A7A;"
                      Click="ClearMenuItem_Click" />
            <MenuItem Header="&#x9000;&#x51FA;"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="AiButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#36506C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <controls:HighlightedTextBlock Grid.Row="0"
                                           Height="23"
                                           FontFamily="MiSans"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryText}"
                                           HighlightBrush="#FFFF0000"
                                           HighlightStart="0"
                                           HighlightLength="2"
                                           Text="AI Search" />

            <Grid Grid.Row="1"
                  Margin="0,3,0,0">
                <TextBox x:Name="QuestionTextBox"
                         Background="{StaticResource SecondaryBackground}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource PrimaryText}"
                         FontFamily="MiSans"
                         FontSize="13"
                         FontWeight="Bold"
                         Padding="9,5"
                         KeyDown="QuestionTextBox_KeyDown"
                         TextChanged="QuestionTextBox_TextChanged" />
                <TextBlock x:Name="PlaceholderText"
                           Margin="11,6,0,0"
                           FontFamily="MiSans"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedText}"
                           Text="Ask anything..."
                           IsHitTestVisible="False" />
            </Grid>

            <TextBlock x:Name="AnswerText"
                       Grid.Row="2"
                       Margin="1,5,1,0"
                       FontFamily="MiSans"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Text="" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button Content="Ask"
                        Style="{StaticResource AiButtonStyle}"
                        Click="AskButton_Click" />
                <Button Content="Copy"
                        Margin="6,0,0,0"
                        Style="{StaticResource AiButtonStyle}"
                        Click="CopyButton_Click" />
                <Button Content="Clear"
                        Margin="6,0,0,0"
                        Style="{StaticResource AiButtonStyle}"
                        Click="ClearButton_Click" />
                <Button Content="Open ChatGPT"
                        Margin="6,0,0,0"
                        Style="{StaticResource AiButtonStyle}"
                        Click="OpenChatGptButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
