<Window x:Class="TimeWidget.AlarmRingingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm"
        Width="300"
        Height="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#F21E2633" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="WarningText" Color="#FFB86C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="1"
                                                  Direction="270"
                                                  Opacity="0.18"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303B4F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#36506C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="18"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TimeText"
                       Grid.Row="0"
                       FontFamily="MiSans"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource WarningText}"
                       Text="07:30" />

            <TextBlock x:Name="LabelText"
                       Grid.Row="1"
                       Margin="0,4,0,0"
                       FontFamily="MiSans"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{StaticResource SecondaryText}"
                       Text="Alarm"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Snooze"
                        Foreground="{StaticResource AccentText}"
                        Click="SnoozeButton_Click" />
                <Button Content="Stop"
                        Margin="10,0,0,0"
                        Click="StopButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

