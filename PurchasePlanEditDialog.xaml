<Window x:Class="TimeWidget.PurchasePlanEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Plan"
        Width="340"
        Height="470"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="FinanceControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="SelectedBackground" Color="#36506C" />
        <SolidColorBrush x:Key="ExpenseText" Color="#FF9B9B" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />
        <Style TargetType="TextBox" BasedOn="{StaticResource FinanceTextBoxStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FinanceComboBoxStyle}" />
        <Style TargetType="Button" BasedOn="{StaticResource FinanceDialogButtonStyle}" />
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="18"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontFamily="MiSans"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryText}"
                       Text="Purchase Plan" />
            <StackPanel Grid.Row="2">
                <TextBox x:Name="NameTextBox"
                         Tag="Item name"
                         ToolTip="Item name" />
                <TextBox x:Name="PriceTextBox"
                         Margin="0,8,0,0"
                         Tag="Estimated price"
                         ToolTip="Estimated price" />
                <ComboBox x:Name="PriorityComboBox"
                          Height="32"
                          Margin="0,8,0,0" />
                <TextBox x:Name="TargetDateTextBox"
                         Margin="0,8,0,0"
                         Tag="Target date (optional), yyyy-MM-dd"
                         ToolTip="Target date, optional yyyy-MM-dd" />
                <ComboBox x:Name="CategoryComboBox"
                          Height="32"
                          Margin="0,8,0,0"
                          IsEditable="True" />
                <TextBox x:Name="NoteTextBox"
                         Height="76"
                         Margin="0,8,0,0"
                         AcceptsReturn="True"
                         Tag="Note (optional)"
                         TextWrapping="Wrap"
                         ToolTip="Note" />
                <TextBlock x:Name="ErrorText"
                           Margin="2,8,0,0"
                           FontFamily="MiSans"
                           FontWeight="Bold"
                           Foreground="{StaticResource ExpenseText}" />
            </StackPanel>
            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="Cancel"
                        Click="CancelButton_Click" />
                <Button Margin="8,0,0,0"
                        Background="{StaticResource AccentText}"
                        Foreground="#1E2633"
                        Content="Save"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
