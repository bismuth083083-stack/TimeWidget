<Window x:Class="TimeWidget.CourseEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course"
        Width="360"
        Height="520"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#F21F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="1"
                                                  Direction="270"
                                                  Opacity="0.18"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="18"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontSize="22"
                       Foreground="{StaticResource PrimaryText}"
                       Text="Course" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox x:Name="CourseNameTextBox"
                         Grid.Row="0"
                         Grid.ColumnSpan="3"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="Course name" />
                <TextBox x:Name="TeacherTextBox"
                         Grid.Row="2"
                         Grid.Column="0"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="Teacher" />
                <TextBox x:Name="LocationTextBox"
                         Grid.Row="2"
                         Grid.Column="2"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="Location" />

                <ComboBox x:Name="DayComboBox"
                          Grid.Row="4"
                          Grid.Column="0" />
                <ComboBox x:Name="WeekTypeComboBox"
                          Grid.Row="4"
                          Grid.Column="2" />

                <TextBox x:Name="StartSectionTextBox"
                         Grid.Row="6"
                         Grid.Column="0"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="Start section" />
                <TextBox x:Name="EndSectionTextBox"
                         Grid.Row="6"
                         Grid.Column="2"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="End section" />

                <TextBox x:Name="StartWeekTextBox"
                         Grid.Row="8"
                         Grid.Column="0"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="Start week" />
                <TextBox x:Name="EndWeekTextBox"
                         Grid.Row="8"
                         Grid.Column="2"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="End week" />

                <ComboBox x:Name="ColorComboBox"
                          Grid.Row="10"
                          Grid.ColumnSpan="3" />

                <TextBox x:Name="NoteTextBox"
                         Grid.Row="12"
                         Grid.ColumnSpan="3"
                         Height="58"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         GotKeyboardFocus="PlaceholderTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="PlaceholderTextBox_LostKeyboardFocus"
                         ToolTip="Note" />

                <TextBlock x:Name="ErrorText"
                           Grid.Row="14"
                           Grid.ColumnSpan="3"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#FF8A8A"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="CancelButton_Click" />
                <Button Content="Save"
                        Margin="8,0,0,0"
                        Background="{StaticResource AccentText}"
                        Foreground="#111827"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

