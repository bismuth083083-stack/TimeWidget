<Window x:Class="TimeWidget.AlarmWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Alarms"
        Width="360"
        Height="480"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ResizeMenuItem"
                      Header="&#x5141;&#x8BB8;&#x8C03;&#x6574;&#x5927;&#x5C0F;"
                      IsCheckable="True"
                      Click="ResizeMenuItem_Click" />
            <Separator />
            <MenuItem Header="&#x65B0;&#x589E;&#x95F9;&#x949F;"
                      Click="AddAlarmMenuItem_Click" />
            <MenuItem Header="&#x505C;&#x6B62;&#x6240;&#x6709;&#x54CD;&#x94C3;"
                      Click="StopAllRingingMenuItem_Click" />
            <MenuItem Header="&#x9000;&#x51FA;"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="WarningText" Color="#FFB86C" />
        <SolidColorBrush x:Key="DangerText" Color="#FF8A8A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#36506C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{StaticResource SecondaryBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <controls:HighlightedTextBlock Height="30"
                                                   FontFamily="MiSans"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryText}"
                                                   HighlightBrush="#FFFF0000"
                                                   HighlightStart="0"
                                                   HighlightLength="1"
                                                   Text="Alarms" />
                    <TextBlock x:Name="CurrentTimeText"
                               Margin="1,2,0,0"
                               FontFamily="MiSans"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Text="00:00:00" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="32"
                        Height="32"
                        Content="+"
                        FontSize="18"
                        Foreground="{StaticResource AccentText}"
                        Style="{StaticResource IconButtonStyle}"
                        Click="AddAlarmButton_Click" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,8,0,8">
                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="MiSans"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedText}"
                           Text="No alarms yet" />
                <ListBox x:Name="AlarmsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding AlarmItems}"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="MiSans"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentText}"
                                           Text="{Binding TimeText}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="6,0,10,0">
                                    <TextBlock FontFamily="MiSans"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryText}"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="MiSans"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryText}"
                                               Text="{Binding RepeatText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              VerticalAlignment="Center"
                                              Tag="{Binding Alarm}"
                                              Click="EnabledCheckBox_Click" />
                                    <Button Content="E"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Tag="{Binding Alarm}"
                                            Click="EditAlarmButton_Click" />
                                    <Button Content="X"
                                            Margin="6,0,0,0"
                                            Foreground="{StaticResource DangerText}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Tag="{Binding Alarm}"
                                            Click="DeleteAlarmButton_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <TextBlock x:Name="NextAlarmText"
                       Grid.Row="2"
                       VerticalAlignment="Center"
                       FontFamily="MiSans"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{StaticResource WarningText}"
                       Text="No active alarms"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
