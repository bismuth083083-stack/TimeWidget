<Window x:Class="TimeWidget.AlarmEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm"
        Width="320"
        Height="330"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#1E2633" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="DangerText" Color="#FF8A8A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="18"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontFamily="MiSans"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryText}"
                       Text="Alarm" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HourTextBox"
                         Grid.Column="0"
                         MaxLength="2"
                         Text="07" />
                <TextBox x:Name="MinuteTextBox"
                         Grid.Column="2"
                         MaxLength="2"
                         Text="30" />
            </Grid>

            <TextBox x:Name="LabelTextBox"
                     Grid.Row="3"
                     Margin="0,12,0,0"
                     Text="Morning" />

            <WrapPanel Grid.Row="4"
                       Margin="0,14,0,0">
                <CheckBox x:Name="MonCheckBox" Content="Mon" Margin="0,0,10,6" />
                <CheckBox x:Name="TueCheckBox" Content="Tue" Margin="0,0,10,6" />
                <CheckBox x:Name="WedCheckBox" Content="Wed" Margin="0,0,10,6" />
                <CheckBox x:Name="ThuCheckBox" Content="Thu" Margin="0,0,10,6" />
                <CheckBox x:Name="FriCheckBox" Content="Fri" Margin="0,0,10,6" />
                <CheckBox x:Name="SatCheckBox" Content="Sat" Margin="0,0,10,6" />
                <CheckBox x:Name="SunCheckBox" Content="Sun" Margin="0,0,10,6" />
            </WrapPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,10,0,0">
                <TextBlock FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedText}"
                           Text="Snooze minutes" />
                <TextBox x:Name="SnoozeTextBox"
                         Margin="0,5,0,0"
                         Text="5" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           FontFamily="MiSans"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerText}"
                           Text=""
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="CancelButton_Click" />
                <Button Content="Save"
                        Margin="10,0,0,0"
                        Foreground="{StaticResource AccentText}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
