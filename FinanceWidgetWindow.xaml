<Window x:Class="TimeWidget.FinanceWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance"
        Width="360"
        Height="520"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="置顶"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="锁定位置"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="新增记录"
                      Click="AddRecordMenuItem_Click" />
            <MenuItem Header="导出数据"
                      Click="ExportMenuItem_Click" />
            <MenuItem Header="退出"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="FinanceControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="MainBackground" Color="#1F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="SelectedBackground" Color="#36506C" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="IncomeText" Color="#7BD88F" />
        <SolidColorBrush x:Key="ExpenseText" Color="#FF9B9B" />
        <SolidColorBrush x:Key="WarningText" Color="#FFCC7A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="FinanceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SelectedBackground}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FinanceButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource FinanceComboBoxStyle}">
            <Setter Property="Height" Value="30" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TransactionsTabButton"
                        Grid.Column="0"
                        Content="Transactions"
                        Style="{StaticResource FinanceButtonStyle}"
                        Click="TransactionsTabButton_Click" />
                <Button x:Name="PurchaseTabButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Purchase Plan"
                        Style="{StaticResource FinanceButtonStyle}"
                        Click="PurchaseTabButton_Click" />
            </Grid>

            <Grid x:Name="TransactionsPanel"
                  Grid.Row="1"
                  Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="3">
                    <Border Margin="0,0,6,0" Padding="10" Background="{StaticResource SecondaryBackground}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Income" FontFamily="MiSans" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="MonthIncomeText" Margin="0,8,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="15" Foreground="{StaticResource IncomeText}" Text="¥0.00" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0,3,0" Padding="10" Background="{StaticResource SecondaryBackground}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Expense" FontFamily="MiSans" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="MonthExpenseText" Margin="0,8,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="15" Foreground="{StaticResource ExpenseText}" Text="¥0.00" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,0" Padding="10" Background="{StaticResource SecondaryBackground}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Balance" FontFamily="MiSans" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="MonthBalanceText" Margin="0,8,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentText}" Text="¥0.00" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TransactionFilterComboBox"
                              Grid.Column="0"
                              SelectionChanged="TransactionFilterComboBox_SelectionChanged" />
                    <TextBlock x:Name="TransactionCountText"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}" />
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="NoTransactionsText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Text="No records" />
                    <ListBox x:Name="TransactionsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="TransactionsListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7"
                                        Padding="11,9"
                                        Background="{StaticResource SecondaryBackground}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontFamily="MiSans" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryText}" Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SecondaryText}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontFamily="MiSans" FontWeight="Bold" FontSize="14" Foreground="{Binding AmountBrush}" Text="{Binding SignedAmountText}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="E" CommandParameter="{Binding Id}" Style="{StaticResource IconButtonStyle}" Click="EditTransactionButton_Click" />
                                            <Button Margin="5,0,0,0" Content="X" CommandParameter="{Binding Id}" Background="#55FF9B9B" Foreground="{StaticResource ExpenseText}" Style="{StaticResource IconButtonStyle}" Click="DeleteTransactionButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Add Income" Foreground="{StaticResource IncomeText}" Style="{StaticResource FinanceButtonStyle}" Click="AddIncomeButton_Click" />
                    <Button Grid.Column="2" Content="Add Expense" Foreground="{StaticResource ExpenseText}" Style="{StaticResource FinanceButtonStyle}" Click="AddExpenseButton_Click" />
                </Grid>
            </Grid>

            <Grid x:Name="PurchasePanel"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="3">
                    <Border Margin="0,0,6,0" Padding="10" Background="{StaticResource SecondaryBackground}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Pending" FontFamily="MiSans" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="PendingCountText" Margin="0,8,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentText}" Text="0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0,3,0" Padding="10" Background="{StaticResource SecondaryBackground}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Estimate" FontFamily="MiSans" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="EstimatedTotalText" Margin="0,8,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="15" Foreground="{StaticResource WarningText}" Text="¥0.00" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,0" Padding="10" Background="{StaticResource SecondaryBackground}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Bought" FontFamily="MiSans" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="PurchasedCountText" Margin="0,8,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="18" Foreground="{StaticResource IncomeText}" Text="0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PurchaseFilterComboBox"
                              Grid.Column="0"
                              SelectionChanged="PurchaseFilterComboBox_SelectionChanged" />
                    <TextBlock x:Name="PurchaseCountText"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}" />
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="NoPurchaseText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="MiSans"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Text="No purchase plans" />
                    <ListBox x:Name="PurchaseListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PurchaseListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7"
                                        Padding="11,9"
                                        Opacity="{Binding RowOpacity}"
                                        Background="{StaticResource SecondaryBackground}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="12" Foreground="{Binding PriorityBrush}" Text="{Binding Priority}" />
                                                <TextBlock FontFamily="MiSans" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Margin="0,4,0,0" FontFamily="MiSans" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SecondaryText}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionText}" CommandParameter="{Binding Id}" Width="30" Style="{StaticResource IconButtonStyle}" Click="TogglePurchasedButton_Click" />
                                            <Button Margin="5,0,0,0" Content="E" CommandParameter="{Binding Id}" Style="{StaticResource IconButtonStyle}" Click="EditPurchaseButton_Click" />
                                            <Button Margin="5,0,0,0" Content="X" CommandParameter="{Binding Id}" Background="#55FF9B9B" Foreground="{StaticResource ExpenseText}" Style="{StaticResource IconButtonStyle}" Click="DeletePurchaseButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button Grid.Row="3"
                        Margin="0,8,0,0"
                        Content="Add Purchase Plan"
                        Style="{StaticResource FinanceButtonStyle}"
                        Click="AddPurchaseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
