<Window x:Class="TimeWidget.TimerWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeWidget.Controls"
        Title="Timer"
        Width="360"
        Height="320"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="&#x7F6E;&#x9876;"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem"
                      Header="&#x9501;&#x5B9A;&#x4F4D;&#x7F6E;"
                      IsCheckable="True"
                      Click="LockMenuItem_Click" />
            <Separator />
            <MenuItem Header="&#x91CD;&#x7F6E;"
                      Click="ResetMenuItem_Click" />
            <MenuItem Header="&#x9000;&#x51FA;"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#F21F1E33" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#273142" />
        <SolidColorBrush x:Key="HoverBackground" Color="#303B4F" />
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB8C8" />
        <SolidColorBrush x:Key="MutedText" Color="#7F8EA3" />
        <SolidColorBrush x:Key="AccentText" Color="#A7D8FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4658" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="MiSans" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="1"
                                                  Direction="270"
                                                  Opacity="0.18"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="8"
            CornerRadius="22"
            Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StopwatchModeButton"
                            Content="Stopwatch"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="StopwatchModeButton_Click" />
                    <Button x:Name="TimerModeButton"
                            Content="Timer"
                            Margin="8,0,0,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="TimerModeButton_Click" />
                </StackPanel>
                <controls:HighlightedTextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Height="18"
                                               FontFamily="MiSans"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentText}"
                                               HighlightBrush="#FFFF0000"
                                               HighlightStart="0"
                                               HighlightLength="1"
                                               Text="Timer" />
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel x:Name="StopwatchPanel"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StopwatchDisplayText"
                               HorizontalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"
                               Text="00:00:00.00" />
                    <ItemsControl x:Name="LapItemsControl"
                                  Margin="0,8,0,0"
                                  ItemsSource="{Binding LapRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="MiSans"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedText}"
                                           Text="{Binding DisplayText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="TimerPanel"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TimerDisplayText"
                               HorizontalAlignment="Center"
                               FontFamily="MiSans"
                               FontSize="44"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"
                               Text="25:00" />
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBox x:Name="MinutesTextBox"
                                 Width="54"
                                 Height="26"
                                 Background="{StaticResource SecondaryBackground}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Foreground="{StaticResource PrimaryText}"
                                 FontFamily="MiSans"
                                 FontWeight="Bold"
                                 TextAlignment="Center"
                                 Text="25" />
                        <TextBlock Margin="6,4,0,0"
                                   FontFamily="MiSans"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedText}"
                                   Text="minutes" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TimerShortcutPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Button Content="5m"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="FiveMinutesButton_Click" />
                <Button Content="25m"
                        Margin="8,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="TwentyFiveMinutesButton_Click" />
                <Button Content="45m"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="FortyFiveMinutesButton_Click" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">
                <Button x:Name="StartButton"
                        Content="Start"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="StartButton_Click" />
                <Button x:Name="PauseButton"
                        Content="Pause"
                        Margin="8,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="PauseButton_Click" />
                <Button Content="Reset"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="ResetButton_Click" />
                <Button x:Name="LapButton"
                        Content="Lap"
                        Margin="8,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="LapButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

